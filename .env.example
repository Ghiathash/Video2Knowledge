APP_ENV=development
VIDEO2KNOWLEDGE_OUTPUT_DIR=./data/output

# Gemini models (optional)
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_VISION_MODEL=
GEMINI_LLM_MODEL=
GEMINI_VERIFICATION_MODEL=

# Generic OpenAI-compatible models (optional; key may be blank for local servers)
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_VISION_MODEL=
OPENAI_COMPATIBLE_LANGUAGE_MODEL=
OPENAI_COMPATIBLE_VERIFICATION_MODEL=

# Local providers (models must already be installed in Ollama)
LOCAL_ASR_MODEL=medium
LOCAL_ASR_DEVICE=cpu
LOCAL_ASR_COMPUTE_TYPE=int8
LOCAL_VISION_MODEL=
LOCAL_LLM_MODEL=
LOCAL_VERIFICATION_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=
OLLAMA_LANGUAGE_MODEL=
OLLAMA_VERIFICATION_MODEL=

# Persistent model caches
HF_HOME=./models/huggingface
