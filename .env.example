APP_ENV=development
VIDEO2KNOWLEDGE_OUTPUT_DIR=./data/output

# Gemini cloud providers
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_VISION_MODEL=
GEMINI_LLM_MODEL=
GEMINI_VERIFICATION_MODEL=

# Local providers (models must already be installed in Ollama)
LOCAL_ASR_MODEL=medium
LOCAL_ASR_DEVICE=cpu
LOCAL_ASR_COMPUTE_TYPE=int8
LOCAL_VISION_MODEL=
LOCAL_LLM_MODEL=
LOCAL_VERIFICATION_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Persistent model caches
HF_HOME=./models/huggingface
